---
// One-shot falling blocks hero. Respects reduced motion. Canvas, ~12 blocks then rest.
---
<canvas id="hero-blocks" class="w-full h-28 rounded-xl hairline bg-white/50 dark:bg-white/[0.02]" aria-hidden="true"></canvas>
<script is:inline>
  (() => {
    const c = document.getElementById('hero-blocks');
    if (!c || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const ctx = c.getContext('2d');
    const W = (c.width = c.offsetWidth * 2), H = (c.height = 224);
    const colors = ['#8B7CF6', '#7DE8C0', '#FFC86B', '#B79CFF'];
    const size = 28;
    const cols = Math.floor(W / size);
    const landed = new Array(cols).fill(0);
    const queue = Array.from({ length: 12 }, (_, i) => ({
      col: Math.floor(Math.random() * cols), y: -i * 90 - 40,
      color: colors[i % colors.length], speed: 3 + Math.random() * 2,
    }));
    let done = false;
    function frame() {
      ctx.clearRect(0, 0, W, H);
      ctx.strokeStyle = 'rgba(139,124,246,.12)';
      for (let x = 0; x < W; x += size * 2) { ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, H); ctx.stroke(); }
      let moving = false;
      for (const b of queue) {
        const floor = H - landed[b.col] * size - size;
        if (b.y < floor) { b.y += b.speed; moving = true; }
        else { b.y = floor; }
        ctx.fillStyle = b.color + 'CC';
        const px = b.col * size, py = Math.max(b.y, 0);
        ctx.beginPath(); ctx.roundRect(px + 3, py + 3, size - 6, size - 6, 6); ctx.fill();
      }
      // mark landed once settled (approx: single pass then freeze)
      if (!moving && !done) {
        done = true;
        for (const b of queue) landed[b.col] = Math.min(landed[b.col] + 0.25, 3);
        return; // freeze frame, no loop
      }
      if (!done) requestAnimationFrame(frame);
    }
    // trigger on view, run once
    const io = new IntersectionObserver((e) => { if (e[0].isIntersecting) { frame(); io.disconnect(); } });
    io.observe(c);
  })();
</script>
