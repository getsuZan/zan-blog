---
interface Props { title: string; href: string; date: string; excerpt: string; tags?: string[]; badge?: string; }
const { title, href, date, excerpt, tags = [], badge } = Astro.props;
---
<a href={href} class="card hairline rounded-xl p-5 block bg-white/70 dark:bg-white/[0.03]">
  <div class="flex items-center gap-2 font-mono text-[11px] uppercase tracking-wider text-black/50 dark:text-white/50">
    <time>{date}</time>
    {badge && <span class="px-2 py-0.5 rounded-full border border-[#8B7CF6]/40 text-[#8B7CF6]">{badge}</span>}
  </div>
  <h3 class="mt-1 text-lg font-semibold" style="font-family: var(--font-display)">{title}</h3>
  <p class="mt-1 text-sm text-black/60 dark:text-white/60 line-clamp-2">{excerpt}</p>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5 font-mono text-[11px]">
      {tags.map(t => <span class="px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">#{t}</span>)}
    </div>
  )}
</a>
