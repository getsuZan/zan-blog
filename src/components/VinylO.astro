---
// Spinning vinyl whose label is the O tetromino. Single instance on /now.
---
<div class="vinyl-box" aria-hidden="true">
  <div class="vinyl-disc">
    <div class="vinyl-label">
      <span class="vinyl-o"><i></i><i></i><i></i><i></i></span>
      <span class="vinyl-hole"></span>
    </div>
  </div>
  <span class="tonearm-pivot"></span>
  <div class="tonearm"><span class="tonearm-bar"></span><span class="tonearm-shell"></span></div>
</div>
