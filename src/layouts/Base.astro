---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import socials from '../data/socials.json';

interface Props { title?: string; description?: string; }
const { title = 'zan-blog', description = 'Personal notes on interests and research.' } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
  <ClientRouter />
  <script is:inline>
    try {
      const t = localStorage.getItem('zan-theme');
      if (t === 'light') document.documentElement.classList.remove('dark');
    } catch {}
  </script>
</head>
<body class="bg-[#FAF9FF] text-[#221d38] dark:bg-[#0E0B16] dark:text-[#ece9f7] min-h-screen flex flex-col">
  <div class="dotgrid fixed inset-0 pointer-events-none opacity-60 dark:opacity-40" aria-hidden="true"></div>
  <header class="relative z-10 border-b border-black/10 dark:border-white/10 backdrop-blur bg-white/60 dark:bg-[#0E0B16]/70 sticky top-0">
    <nav class="max-w-3xl mx-auto px-5 h-14 flex items-center justify-between font-mono text-sm">
      <a href={import.meta.env.BASE_URL} class="flex items-center gap-2 font-bold tracking-tight" style="font-family: var(--font-display)">
        <svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><rect x="1" y="1" width="8" height="8" rx="1.5" fill="#8B7CF6"/><rect x="11" y="1" width="8" height="8" rx="1.5" fill="#8B7CF6" opacity=".55"/><rect x="1" y="11" width="8" height="8" rx="1.5" fill="#7DE8C0" opacity=".8"/><rect x="11" y="11" width="8" height="8" rx="1.5" fill="#FFC86B" opacity=".7"/></svg>
        zan-blog
      </a>
      <div class="flex items-center gap-5">
        <a class="navlink" data-active={isActive('/blog')} href={`${import.meta.env.BASE_URL}blog`}>blog</a>
        <a class="navlink" data-active={isActive('/research')} href={`${import.meta.env.BASE_URL}research`}>research</a>
        <a class="navlink" data-active={isActive('/about')} href={`${import.meta.env.BASE_URL}about`}>about</a>
        <a class="navlink" data-active={isActive('/now')} href={`${import.meta.env.BASE_URL}now`}>now</a>
        <button id="theme-btn" aria-label="Toggle theme" class="hairline rounded-full w-8 h-8 grid place-items-center hover:border-[#8B7CF6] transition-colors">◐</button>
      </div>
    </nav>
    <div id="progress" class="h-[2px] w-full origin-left scale-x-0 bg-gradient-to-r from-[#8B7CF6] via-[#7DE8C0] to-[#FFC86B]"></div>
  </header>
  <main class="relative z-10 flex-1 w-full max-w-3xl mx-auto px-5 py-10">
    <slot />
  </main>
  <footer class="relative z-10 border-t border-black/10 dark:border-white/10">
    <div class="max-w-3xl mx-auto px-5 py-6 flex items-center justify-between font-mono text-xs text-black/50 dark:text-white/50">
      <span>© zan-blog · built with astro</span>
      <span class="flex gap-3">
        {socials.github && <a class="hover:text-[#8B7CF6]" href={socials.github}>gh</a>}
        {socials.twitter && <a class="hover:text-[#8B7CF6]" href={socials.twitter}>tw</a>}
        {socials.mastodon && <a class="hover:text-[#8B7CF6]" href={socials.mastodon}>mstdn</a>}
        <a class="hover:text-[#8B7CF6]" href={`${import.meta.env.BASE_URL}rss.xml`}>rss</a>
      </span>
    </div>
  </footer>
  <script is:inline>
    const btn = document.getElementById('theme-btn');
    btn?.addEventListener('click', () => {
      const el = document.documentElement;
      el.classList.toggle('dark');
      try { localStorage.setItem('zan-theme', el.classList.contains('dark') ? 'dark' : 'light'); } catch {}
    });
    const bar = document.getElementById('progress');
    addEventListener('scroll', () => {
      const h = document.documentElement;
      const p = h.scrollTop / (h.scrollHeight - h.clientHeight || 1);
      if (bar) bar.style.transform = `scaleX(${p})`;
    }, { passive: true });
  </script>
</body>
</html>
