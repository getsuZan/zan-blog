---
import Base from '../layouts/Base.astro';
import NowRow from '../components/NowRow.astro';
import VinylO from '../components/VinylO.astro';
import now from '../data/now.json';
const pad = (i: number) => `0${i + 1}`;
---
<Base title="now — zan-blog" description="What I'm listening to and reading lately.">
  <h1 class="text-3xl font-bold" style="font-family: var(--font-display)">now</h1>
  <p class="mt-2 font-mono text-xs opacity-50">updated {now.updated} · edit <code>src/data/now.json</code></p>
  <p class="mt-3 text-sm opacity-70">{now.status}</p>

  <h2 class="mt-10 font-mono text-[11px] uppercase tracking-widest text-(--p-comp)">♪ listening lately</h2>
  <div class="mt-2 flex gap-5 items-start">
    <div class="mt-2"><VinylO /></div>
    <ol class="flex-1">
      {now.music.map((m, i) => (
        <NowRow index={pad(i)} title={m.title} sub={`${m.artist} · ${m.note}`} marker="gt" />
      ))}
    </ol>
  </div>

  <h2 class="mt-10 font-mono text-[11px] uppercase tracking-widest text-(--p-comp)">▤ reading lately</h2>
  <ol class="mt-2">
    {now.reading.map((r, i) => (
      <NowRow index={pad(i)} title={r.title} sub={`${r.author} · ${r.progress}`} extra={r.kind} marker="tab" />
    ))}
  </ol>
</Base>
