---
import Base from '../layouts/Base.astro';
import now from '../data/now.json';
---
<Base title="now — zan-blog" description="What I'm listening to, reading, using.">
  <h1 class="text-3xl font-bold" style="font-family: var(--font-display)">now / uses</h1>
  <p class="mt-2 font-mono text-xs opacity-50">updated {now.updated} · edit <code>src/data/now.json</code></p>
  <p class="mt-3 text-sm opacity-70">{now.status}</p>
  <div class="mt-6 grid sm:grid-cols-2 gap-3">
    <div class="hairline rounded-xl p-4">
      <p class="font-mono text-[11px] uppercase tracking-widest opacity-50">♪ listening</p>
      <ul class="mt-2 space-y-2 text-sm">
        {now.music.map(m => <li><div class="font-medium">{m.title}</div><div class="opacity-60">{m.artist} · {m.note}</div></li>)}
      </ul>
    </div>
    <div class="hairline rounded-xl p-4">
      <p class="font-mono text-[11px] uppercase tracking-widest opacity-50">▤ reading</p>
      <ul class="mt-2 space-y-2 text-sm">
        {now.reading.map(r => <li><div class="font-medium">{r.title} <span class="font-mono text-[11px] opacity-60">[{r.kind}]</span></div><div class="opacity-60">{r.author} · {r.progress}</div></li>)}
      </ul>
    </div>
  </div>
</Base>
