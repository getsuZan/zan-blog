---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const items = await getCollection('posts', ({ data }) => !data.draft);
  return items.map(p => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
import { getEntry } from 'astro:content';
const { slug } = Astro.props;
const entry = await getEntry('posts', slug);
if (!entry) throw new Error(`Missing post: ${slug}`);
const { Content } = await entry.render();
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;
const words = entry.body.split(/\s+/).length;
const mins = Math.max(1, Math.round(words / 200));
---
<Base title={`${entry.data.title} — zan-blog`} description={entry.data.excerpt}>
  <a href={`${base}blog`} class="font-mono text-xs opacity-60 hover:text-[#8B7CF6]">← all posts</a>
  <h1 class="mt-2 text-3xl font-bold tracking-tight" style="font-family: var(--font-display)">{entry.data.title}</h1>
  <div class="mt-2 flex items-center gap-3 font-mono text-xs opacity-60">
    <time>{fmt(entry.data.date)}</time><span>·</span><span>{mins} min</span>
    {entry.data.type === 'research' && <span class="px-2 py-0.5 rounded-full border border-[#8B7CF6]/40 text-[#8B7CF6]">research</span>}
  </div>
  {entry.data.link && <p class="mt-3 text-sm"><a class="underline" href={entry.data.link}>source ↗</a></p>}
  <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-[11px]">
    {entry.data.tags.map(t => <a class="px-2 py-0.5 rounded-full border border-black/10 dark:border-white/10 hover:border-[#8B7CF6]" href={`${base}tags/${t}`}>#{t}</a>)}
  </div>
  <hr class="my-6 border-black/10 dark:border-white/10" />
  <article class="prose-zan text-black/80 dark:text-white/80"><Content /></article>
</Base>
