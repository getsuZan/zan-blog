---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('posts', ({ data }) => !data.draft && data.type === 'post'))
  .sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;
const tags = [...new Set(all.flatMap(p => p.data.tags))].sort();
const payload = all.map(p => ({ slug: p.slug, title: p.data.title, excerpt: p.data.excerpt, date: fmt(p.data.date), tags: p.data.tags }));
---
<Base title="blog — zan-blog" description="All blog posts.">
  <h1 class="text-3xl font-bold" style="font-family: var(--font-display)">blog</h1>
  <div class="mt-4 flex flex-col sm:flex-row gap-2">
    <input id="q" type="search" placeholder="search posts…" class="hairline rounded-lg px-3 py-2 bg-transparent text-sm flex-1 outline-none focus:border-[#8B7CF6]" />
    <div id="tagrow" class="flex flex-wrap gap-1.5 font-mono text-[11px]">
      <button data-tag="" class="tagbtn px-2 py-1 rounded-full border border-[#8B7CF6] text-[#8B7CF6]">all</button>
      {tags.map(t => <button data-tag={t} class="tagbtn px-2 py-1 rounded-full border border-black/15 dark:border-white/15 opacity-70">#{t}</button>)}
    </div>
  </div>
  <div id="list" class="mt-5 grid gap-3"></div>
  <p id="empty" class="hidden mt-6 font-mono text-sm opacity-60">no posts match.</p>
  <script is:inline define:vars={{ payload, base }}>
    const list = document.getElementById('list');
    const q = document.getElementById('q');
    const empty = document.getElementById('empty');
    let tag = new URLSearchParams(location.search).get('tag') || '';
    if (q) q.value = new URLSearchParams(location.search).get('q') || '';
    const btns = [...document.querySelectorAll('.tagbtn')];
    function paint() {
      btns.forEach(b => {
        const on = (b.dataset.tag || '') === tag;
        b.style.borderColor = on ? '#8B7CF6' : '';
        b.style.color = on ? '#8B7CF6' : '';
        b.style.opacity = on ? '1' : '';
      });
    }
    function render() {
      const needle = (q?.value || '').toLowerCase();
      const rows = payload.filter(p =>
        (!tag || p.tags.includes(tag)) &&
        (!needle || (p.title + ' ' + p.excerpt + ' ' + p.tags.join(' ')).toLowerCase().includes(needle)));
      list.innerHTML = rows.map(p => `
        <a href="${base}blog/${p.slug}" class="card hairline rounded-xl p-5 block bg-white/70 dark:bg-white/[0.03]">
          <div class="font-mono text-[11px] uppercase tracking-wider opacity-50"><time>${p.date}</time></div>
          <h3 class="mt-1 text-lg font-semibold">${p.title}</h3>
          <p class="mt-1 text-sm opacity-60">${p.excerpt}</p>
          <div class="mt-3 flex flex-wrap gap-1.5 font-mono text-[11px]">${p.tags.map(t => `<span class="px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10">#${t}</span>`).join('')}</div>
        </a>`).join('');
      empty.classList.toggle('hidden', rows.length > 0);
      paint();
    }
    btns.forEach(b => b.addEventListener('click', () => { tag = b.dataset.tag || ''; render(); }));
    q?.addEventListener('input', render);
    render();
  </script>
</Base>
