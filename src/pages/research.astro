---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('posts', ({ data }) => !data.draft && data.type === 'research'))
  .sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;
---
<Base title="research — zan-blog" description="Research topics I liked.">
  <h1 class="text-3xl font-bold" style="font-family: var(--font-display)">research</h1>
  <p class="mt-2 text-sm text-black/60 dark:text-white/60">Short notes on papers and topics I liked. Longer opinion pieces live in <a class="underline" href={`${base}blog`}>blog</a>.</p>
  <div class="mt-5 grid gap-3">
    {items.map(p => <PostCard title={p.data.title} href={`${base}blog/${p.slug}`} date={fmt(p.data.date)} excerpt={p.data.excerpt} tags={p.data.tags} badge="research" />)}
    {items.length === 0 && <p class="font-mono text-sm opacity-60">nothing yet.</p>}
  </div>
</Base>
